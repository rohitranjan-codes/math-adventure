# Copy to .env (or export in your shell). Only ANTHROPIC_API_KEY is required.
ANTHROPIC_API_KEY=sk-ant-...

# Where records live. Any path; created on first run.
BIZAGENT_DB=bizagent.db

# Tell the agent who it works for. Free text, shown in the system prompt.
BIZAGENT_BUSINESS_NAME=Riverside Plumbing
BIZAGENT_BUSINESS_PROFILE=Two-person plumbing business in Bristol. Standard call-out fee 60. Invoices are due 14 days after issue. Working hours Mon-Fri 08:00-17:00.
BIZAGENT_TZ=Europe/London
BIZAGENT_CURRENCY=GBP

# Model settings. Effort: low | medium | high | xhigh | max
BIZAGENT_MODEL=claude-opus-5-5
BIZAGENT_EFFORT=medium
BIZAGENT_MAX_TOOL_ROUNDS=20

# Set to 1 to skip the y/n prompt on outbound actions (sending, cancelling).
BIZAGENT_AUTO_APPROVE=0
# Set to 0 to disable server-side refusal fallbacks.
BIZAGENT_FALLBACKS=1
